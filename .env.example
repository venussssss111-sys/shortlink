# 复制一份成 .env 再改值：cp .env.example .env
# .env 已经在 .gitignore 里，不会进仓库。
#
# 全部不填也能跑（会用 docker-compose.yml 里的演示默认值），
# 但只要这个仓库要放到公网，下面两项必须换掉。

# MySQL root 密码（首次初始化后改这里不会自动改已存在的库，要动旧库请进容器改）
DB_PASSWORD=change-me-db-password

# JWT 签名密钥：随便一个长随机串，建议 openssl rand -hex 32
# 换掉之后所有人（包括自己）都需要重新登录，因为旧 token 验签会失败
JWT_SECRET=change-me-please-openssl-rand-hex-32

# token 有效期（分钟），1440 = 24 小时
JWT_EXPIRE_MINUTES=1440

# 生成短链时拼在前面的域名，线上换成你的域名（https://s.example.com）
SHORTLINK_DOMAIN=http://localhost:8088

# 允许跨域的来源，逗号分隔。部署地址必须包含在内，否则浏览器登录会 403
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088
